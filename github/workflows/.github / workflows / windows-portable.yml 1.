name: Build TyreTrack Windows Portable
on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'TyreTrack.py'
      - 'count_line.py'
      - 'tyre_detector.pt'
      - 'requirements-build.txt'
      - '.github/workflows/windows-portable.yml'
jobs:
  build:
    runs-on: windows-2022
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          architecture: x64
      - name: Install CPU PyTorch
        run: python -m pip install torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cpu
      - name: Install build requirements
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements-build.txt
      - name: Validate Python imports and model
        run: |
          python -m py_compile TyreTrack.py count_line.py
          python -c "import torch, cv2, depthai, PyQt5, ultralytics; from ultralytics import YOLO; m=YOLO('tyre_detector.pt'); print('MODEL:',m.task,m.names)"
      - name: Build portable executable
        run: |
          python -m PyInstaller --noconfirm --clean --onedir --windowed --name TyreTrack --collect-all ultralytics --collect-all torch --collect-all torchvision --collect-all depthai --collect-all cv2 --collect-all PyQt5 --hidden-import count_line --hidden-import scipy --hidden-import sklearn --hidden-import yaml --add-data "tyre_detector.pt;." TyreTrack.py
      - name: Prepare portable package
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force dist/TyreTrack/data,dist/TyreTrack/reports | Out-Null
          Copy-Item Start_TyreTrack.bat dist/TyreTrack/
          Copy-Item README.txt dist/TyreTrack/
          Compress-Archive -Path dist/TyreTrack -DestinationPath TyreTrack_Windows_Portable.zip -Force
      - name: Upload ZIP
        uses: actions/upload-artifact@v4
        with:
          name: TyreTrack_Windows_Portable
          path: TyreTrack_Windows_Portable.zip
          retention-days: 30
